# =============================================================
#  DATA - excluded for size and licence
#  GUIDE is ~3.5 GB, redistributed by Microsoft under CDLA-2.0.
#  Reproducers download it themselves (see README).
# =============================================================
Dataset/*.csv
Dataset/*.json
Dataset/derived/**/*.csv
Dataset/derived/**/*.parquet
Results/predictions/

# Manifests ARE published: they document every sample and feature
# table (counts, seed, proportions, hashes) without exposing data
!Dataset/derived/**/*manifest*.json
!Dataset/derived/**/*columns*.json

